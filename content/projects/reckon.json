{
  "title": "Reckon",
  "summary": "Reckon is a money app built for my own household. It never connects to a bank; it only knows what you choose to tell it. The identity centres on an impossible balance: a mark that wobbles, falls and restacks itself every time the app opens.",
  "tags": [
    {
      "label": "Brand Identity",
      "color": "orange"
    },
    {
      "label": "Product Design",
      "color": "violet"
    }
  ],
